# /etc/caddy/Caddyfile — HTTPS automático (Let's Encrypt) na frente do gunicorn.
flowtrace.exemplo.com.br {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/flowtrace/app/static
        file_server
    }

    reverse_proxy 127.0.0.1:8000 {
        transport http {
            read_timeout 200s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
