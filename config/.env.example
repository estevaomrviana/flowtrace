SECRET_KEY='minha-chave-secreta'
DEBUG=False
ALLOWED_HOSTS=flowtrace.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://flowtrace.exemplo.com.br

# Chaves Fernet (separadas por vírgula; a primeira cifra, todas decifram).
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY (chave única) continua aceito por compatibilidade.
ENCRYPTION_KEYS='chave-atual'

# opcionais
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=120
SUBSCRIBER_DB_TIMEOUT=15
SESSION_COOKIE_AGE=28800

# Banco PostgreSQL (sem DB_NAME o flowtrace usa o SQLite local, só para desenvolvimento)
DB_NAME=flowtrace
DB_USER=flowtrace
DB_PASSWORD='senha-do-banco'
DB_HOST=localhost
DB_PORT=5432

# Logs recebidos no próprio servidor (modo "execução local"); vazio desliga o modo local
FLOWTRACE_DATA_ROOT=/dados

# Saúde da coleta e alertas (opcionais)
COLLECTION_STALE_MINUTES=15
COLLECTION_REALERT_HOURS=6
NFCAPD_ROTATION_SECONDS=300
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_PING_URL=
